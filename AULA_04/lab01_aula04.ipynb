        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.metrics import classification_report, confusion_matrix\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. CARREGAR DATASET\n",
        "# ============================================================\n",
        "\n",
        "df = pd.read_csv('dataset_moveis_100.csv')\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. DIVISÃO ESTRATIFICADA DE TREINO E TESTE\n",
        "# ============================================================\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    df['texto'],\n",
        "    df['intencao'],\n",
        "    test_size=0.30,\n",
        "    random_state=42,\n",
        "    stratify=df['intencao']\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. CONSTRUÇÃO DA PIPELINE\n",
        "# TF-IDF + DECISION TREE\n",
        "# ============================================================\n",
        "\n",
        "pipeline_tree = Pipeline([\n",
        "    ('vectorizer', TfidfVectorizer()),\n",
        "    ('classifier', DecisionTreeClassifier(random_state=42))\n",
        "])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. TREINAMENTO\n",
        "# ============================================================\n",
        "\n",
        "pipeline_tree.fit(X_train, y_train)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. PREDIÇÕES NO CONJUNTO DE TESTE\n",
        "# ============================================================\n",
        "\n",
        "y_pred = pipeline_tree.predict(X_test)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. MATRIZ DE CONFUSÃO\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n==============================\")\n",
        "print(\"MATRIZ DE CONFUSÃO\")\n",
        "print(\"==============================\")\n",
        "\n",
        "print(confusion_matrix(y_test, y_pred))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. RELATÓRIO DE CLASSIFICAÇÃO\n",
        "# Precision, Recall e F1-Score\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n==============================\")\n",
        "print(\"RELATÓRIO DE CLASSIFICAÇÃO\")\n",
        "print(\"==============================\")\n",
        "\n",
        "print(classification_report(y_test, y_pred))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. TESTES INTERATIVOS - 8 FRASES\n",
        "# ============================================================\n",
        "\n",
        "LIMIAR_CONFIANCA = 0.50\n",
        "\n",
        "print(\"\\n==============================================\")\n",
        "print(\"INICIANDO TESTES INTERATIVOS - 8 FRASES\")\n",
        "print(\"==============================================\")\n",
        "\n",
        "\n",
        "for i in range(1, 9):\n",
        "\n",
        "    print(f\"\\n[Teste {i}/8]\")\n",
        "\n",
        "    # Entrada obrigatória do usuário\n",
        "    frase = input(\"Digite uma frase do cliente: \").strip()\n",
        "\n",
        "    # Previsão da intenção\n",
        "    intencao = pipeline_tree.predict([frase])[0]\n",
        "\n",
        "    # Probabilidades de cada classe\n",
        "    probs = pipeline_tree.predict_proba([frase])\n",
        "\n",
        "    # Maior probabilidade encontrada\n",
        "    maior_prob = np.max(probs)\n",
        "\n",
        "    # ========================================================\n",
        "    # 9. REGRA DE DECISÃO E FALLBACK\n",
        "    # ========================================================\n",
        "\n",
        "    if maior_prob >= LIMIAR_CONFIANCA:\n",
        "\n",
        "        print(f\"Intenção identificada: {intencao}\")\n",
        "        print(f\"Confiança: {maior_prob:.2%}\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\n",
        "            \"Desculpe, não entendi sua solicitação. \"\n",
        "            \"Encaminhando você para um atendente humano...\"\n",
        "        )\n"
