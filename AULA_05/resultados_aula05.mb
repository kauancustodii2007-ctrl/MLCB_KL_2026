# ============================================================

nltk.download("stopwords", quiet=True)

stop_words_pt = set(
    stopwords.words("portuguese")
)

nlp = spacy.load("pt_core_news_sm")

print("Ambiente preparado com sucesso!")


# ============================================================
# 4. FUNÇÃO DO EXERCÍCIO 1
# ============================================================

def limpar_e_lemmatizar(texto):
    """
    Realiza o pré-processamento de uma mensagem.

    Etapas:
    1. Converte para minúsculas
    2. Remove pontuação, números e caracteres especiais
    3. Tokeniza usando spaCy
    4. Remove stopwords
    5. Realiza lemmatization
    6. Remove tokens muito curtos
    7. Retorna o texto normalizado
    """

    # Converter para minúsculas
    texto_limpo = texto.lower()

    # Remover pontuação, números e caracteres especiais
    texto_limpo = re.sub(
        r'[^a-záàâãéèêíïóôõöúçñ\s]',
        '',
        texto_limpo
    )

    # Processar com spaCy
    doc = nlp(texto_limpo)

    tokens_filtrados = []

    for token in doc:

        # Ignorar espaços
        if token.is_space:
            continue

        # Ignorar stopwords
        if token.text in stop_words_pt:
            continue

        # Ignorar tokens muito curtos
        if len(token.text) <= 1:
            continue

        # Adicionar lema
        tokens_filtrados.append(token.lemma_)

    # Reconstruir frase
    return " ".join(tokens_filtrados)


