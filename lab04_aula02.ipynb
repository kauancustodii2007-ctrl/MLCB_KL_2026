# ==============================================================================
# CÉLULA 1: Importação das Bibliotecas e Dependências
# ==============================================================================
import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report, confusion_matrix

print("Bibliotecas carregadas com sucesso!")
# ==============================================================================
# CÉLULA 2: Criação do Dataset de Intenções para Agência de Viagens
# ==============================================================================
# O dataset conta com 15 frases distribuídas em 3 intenções operacionais do bot
dados = {
    "texto": [
        # Intenção: comprar_passagem
        "Quero comprar uma passagem aérea para Salvador",
        "Gostaria de reservar um voo para o Rio de Janeiro amanhã",
        "Qual o valor do bilhete de avião para Lisboa?",
        "Preciso emitir uma passagem para São Paulo mês que vem",
        "Desejo comprar passagens de ida e volta para Paris",

        # Intenção: cancelar_reserva
        "Preciso cancelar a minha reserva de voo",
        "Como faço para solicitar o cancelamento da minha passagem?",
        "Quero anular o bilhete do voo 4052",
        "Gostaria de desistir da viagem e pedir reembolso",
        "Cancelamento de reserva cadastrada no meu CPF",

        # Intenção: falar_atendente
        "Por favor, transfira para um atendente humano",
        "Quero falar com o suporte agora",
        "Preciso de ajuda de um funcionário da agência",
        "Não estou conseguindo resolver pelo robô, me passe para um humano",
        "Me coloque em contato com a equipe de atendimento"
    ],
    "intencao": [
        "comprar_passagem", "comprar_passagem", "comprar_passagem", "comprar_passagem", "comprar_passagem",
        "cancelar_reserva", "cancelar_reserva", "cancelar_reserva", "cancelar_reserva", "cancelar_reserva",
        "falar_atendente", "falar_atendente", "falar_atendente", "falar_atendente", "falar_atendente"
    ]
}

df = pd.DataFrame(dados)

print(f"Total de exemplos: {len(df)}")
print("\nDistribuição das classes:")
print(df['intencao'].value_counts())
# ==============================================================================
# CÉLULA 3: Divisão do Dataset em Conjuntos de Treino e Teste
# ==============================================================================
X = df['texto']
y = df['intencao']

# Divisão 70% treino e 30% teste
# stratify=y garante a mesma proporção das 3 classes no treino e teste
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.3,
    stratify=y,
    random_state=42
)

print(f"Amostras de Treino: {len(X_train)}")
print(f"Amostras de Teste: {len(X_test)}")
# ==============================================================================
# CÉLULA 4: Vetorização e Treinamento do Modelo (Pipeline NLU)
# ==============================================================================
# Escolha do Vetorizador: TfidfVectorizer
# Justificativa: Além de contar a frequência das palavras, pondera termos raros e
# diminui o impacto de stop-words sem necessidade de remoção manual prévia.
vectorizer = TfidfVectorizer(lowercase=True)

# Transformação dos textos em matrizes numéricas
X_train_vec = vectorizer.fit_transform(X_train)
X_test_vec = vectorizer.transform(X_test)

# Escolha do Algoritmo: LogisticRegression
# Justificativa: Apresenta excelente generalização em matrizes esparsas de texto
# e calcula probabilidades bem calibradas mesmo em datasets reduzidos.
model = LogisticRegression(random_state=42)
model.fit(X_train_vec, y_train)

print("Vetorização e Treinamento concluídos!")
# ==============================================================================
# CÉLULA 6: Predição com Frases Inéditas (Requisito 5 e 6)
# ==============================================================================
# Frases que NÃO estavam presentes no dataset original
frases_ineditas = [
    "Tem como me transferir para uma pessoa de verdade?",
    "Quero ver os preços para voar até Buenos Aires",
    "Gostaria de estornar minha compra e suspender a viagem"
]

# Vetorização usando apenas transform() para manter o vocabulário do treino
frases_ineditas_vec = vectorizer.transform(frases_ineditas)

# Predição das intenções e probabilidades associadas
predicoes = model.predict(frases_ineditas_vec)
probabilidades = model.predict_proba(frases_ineditas_vec)

print("="*70)
print(" PREDIÇÕES DO MOTOR NLU PARA FRASES INÉDITAS ")
print("="*70)

for frase, intencao_prevista, proba in zip(frases_ineditas, predicoes, probabilidades):
    confianca = np.max(proba) * 100
    print(f"\n Frase: '{frase}'")
    print(f" Intenção Prevista: [{intencao_prevista.upper()}]")
    print(f" Nível de Confiança: {confianca:.2f}%")
    print("-" * 50)
